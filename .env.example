# Copie para .env na raiz. Este arquivo e apenas um modelo; nao coloque segredos reais no Git.
# O Compose le .env automaticamente. go run e npm run dev, fora do Compose, nao leem.
APP_ENV=development

# Portas publicadas no computador. PORT e reservado para a plataforma de hospedagem.
FRONTEND_PORT=5173
BACKEND_PORT=8080
PORT=
FRONTEND_DIST=

# Credenciais locais de desenvolvimento. Troque-as fora da sua maquina.
# DATABASE_URL abaixo e para Go executado no host; o Compose monta a URL interna.
POSTGRES_USER=symphonia
POSTGRES_PASSWORD=symphonia
POSTGRES_DB=symphonia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://symphonia:symphonia@localhost:5432/symphonia?sslmode=disable

# Obrigatorio: segredo unico com pelo menos 32 bytes; veja o comando no README.
JWT_SECRET=
# Origem aberta no navegador, sem caminho/barra final; usada em links e OAuth.
APP_PUBLIC_URL=http://localhost:5173
# Dentro do Compose, mailpit e o nome do servico. Go no host: localhost:1025.
# Em producao, use SMTP real e um remetente autorizado.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Symphonia <no-reply@symphonia.local>
# Login Google opcional: cliente OAuth Web, separado da chave Gemini.
# URI autorizado: <APP_PUBLIC_URL>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Origens HTTP/WebSocket permitidas. Acrescente dominios HTTPS separados por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# mock testa o fluxo; gemini usa o servico real. Nunca use mock como validacao linguistica.
TRANSLATION_PROVIDER=mock
GEMINI_API_KEY=
# Um projeto seleciona Vertex/ADC e tem precedencia sobre GEMINI_API_KEY.
GOOGLE_CLOUD_PROJECT=
# Arquivo ADC para Go no host; no Docker use o override docker-compose.adc.yml.
GOOGLE_APPLICATION_CREDENTIALS=
# JSON secreto opcional no deploy; requer GOOGLE_CLOUD_PROJECT. Nunca use VITE_*.
GOOGLE_CREDENTIALS_JSON=
TRANSLATION_MODEL=gemini-3.5-live-translate-preview
TEXT_TRANSLATION_MODEL=gemini-3.5-flash-lite
