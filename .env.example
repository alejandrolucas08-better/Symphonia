APP_ENV=development

FRONTEND_PORT=5173
BACKEND_PORT=8080

POSTGRES_USER=symphonia
POSTGRES_PASSWORD=symphonia
POSTGRES_DB=symphonia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://symphonia:symphonia@localhost:5432/symphonia?sslmode=disable

JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Translation: mock validates the flow locally; gemini uses the Live API.
TRANSLATION_PROVIDER=mock
GEMINI_API_KEY=
# Recommended: Vertex ADC. Project takes precedence over GEMINI_API_KEY.
GOOGLE_CLOUD_PROJECT=
# For local Go execution; mount this file explicitly when using Docker.
GOOGLE_APPLICATION_CREDENTIALS=
TRANSLATION_MODEL=gemini-3.5-live-translate-preview
